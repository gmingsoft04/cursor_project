# Serper.dev Google Search API
SERPER_API_KEY=

# Apollo.io API
APOLLO_API_KEY=
APOLLO_API_BASE=https://api.apollo.io/v1

# LinkedIn official API token. Access to organization endpoints depends on your LinkedIn app permissions.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_BASE=https://api.linkedin.com/v2

# Generic customs/import data provider. Configure to your provider's REST endpoint.
CUSTOMS_API_BASE=
CUSTOMS_API_KEY=
CUSTOMS_IMPORT_ENDPOINT=/import-records

# Runtime
LEADS_DB_PATH=fastcharge_leads.sqlite3
REQUEST_TIMEOUT_SECONDS=20

# AI email generation. Any OpenAI-compatible chat completion endpoint can be used.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# SMTP sending. Emails are only sent after a draft is approved.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FastCharge Sales
SMTP_USE_TLS=true

# Local dashboard auth. Change the default password before exposing the API.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_SESSION_HOURS=12
CORS_ALLOW_ORIGIN=http://127.0.0.1:5173

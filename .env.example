# Serper.dev Google Search API
SERPER_API_KEY=

# Apollo.io API
APOLLO_API_KEY=
APOLLO_API_BASE=https://api.apollo.io/v1

# LinkedIn official API token. Access to organization endpoints depends on your LinkedIn app permissions.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_BASE=https://api.linkedin.com/v2

# Generic customs/import data provider. Configure to your provider's REST endpoint.
CUSTOMS_API_BASE=
CUSTOMS_API_KEY=
CUSTOMS_IMPORT_ENDPOINT=/import-records

# Runtime
LEADS_DB_PATH=fastcharge_leads.sqlite3
REQUEST_TIMEOUT_SECONDS=20

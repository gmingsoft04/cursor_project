<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysTenantMapper">

    <resultMap id="SysTenantResult" type="com.ruoyi.system.domain.SysTenant">
        <id property="id" column="id"/>
        <result property="tenantCode" column="tenant_code"/>
        <result property="tenantName" column="tenant_name"/>
        <result property="status" column="status"/>
        <result property="expireTime" column="expire_time"/>
        <result property="planCode" column="plan_code"/>
        <result property="seatLimit" column="seat_limit"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByTenantCode" resultMap="SysTenantResult">
        SELECT id, tenant_code, tenant_name, status, expire_time, plan_code, seat_limit, create_time
        FROM sys_tenant
        WHERE tenant_code = #{tenantCode}
    </select>
</mapper>

# ==== 应用配置 ====
APP_NAME=外贸客户开发系统
APP_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=please-change-me-to-a-random-string

# ==== 数据库 ====
DATABASE_URL=sqlite:///./data/app.db

# ==== 邮件搜索 API ====
# Hunter.io API key（可选，用于按域名/公司搜索邮箱）
# 注册地址：https://hunter.io/api
HUNTER_API_KEY=

# SerpAPI key（可选，用于关键字 -> 公司域名）
# 注册地址：https://serpapi.com/
SERPAPI_KEY=

# 搜索来源优先级，逗号分隔：hunter,serpapi,demo
SEARCH_PROVIDERS=hunter,serpapi,demo

# ==== SMTP 发信配置 ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=your-email@example.com

# 单次群发最大并发与间隔（秒），用于反垃圾节流
SEND_BATCH_INTERVAL=2
